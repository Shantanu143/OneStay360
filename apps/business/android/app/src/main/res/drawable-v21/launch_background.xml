<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: the brand card colour with the app icon, matching
     the Flutter BrandSplash that follows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FF12241F" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
