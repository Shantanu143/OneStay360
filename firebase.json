{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "ignore": [
    "**/node_modules/**",
    "**/.*/**",
    "**/build/**",
    "**/.git/**"
  ],
  "hosting": {
    "public": "hosting/app-links",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=600" },
          { "key": "Content-Type", "value": "application/json; charset=utf-8" }
        ]
      }
    ]
  }
}
