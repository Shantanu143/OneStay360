rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    // Property images (listings)
    match /property_images/{propertyId}/{fileName} {
      // Anyone can view property listing photos
      allow read: if true;

      // Only authenticated users can upload property images (max 10MB, images only)
      allow write: if isAuth()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Only authenticated users can delete images
      allow delete: if isAuth();
    }

    // Tenant KYC & verification documents (Aadhaar, IDs, agreements)
    match /tenant_documents/{tenantId}/{fileName} {
      // Only authenticated users with legitimate access can read documents
      allow read: if isAuth();

      // Only authenticated users can upload documents (max 15MB, PDF or images)
      allow write: if isAuth()
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');

      // Delete restricted to authenticated users
      allow delete: if isAuth();
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
